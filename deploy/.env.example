# Use a unique value of at least 32 characters. Do not commit a real secret.
POLICY_SERVICE_TOKEN=replace-this-with-a-unique-32-character-secret
INFLUXDB_ADMIN_TOKEN=replace-this-with-a-different-32-character-secret
GRAFANA_ADMIN_PASSWORD=replace-this-with-a-third-32-character-secret

# Optional ingestion authentication. Use a fourth distinct random secret.
# Empty preserves legacy local-development behavior; enable before a managed pilot.
METRICS_AUTH_TOKEN=