[Unit]
Description=PulseRoute WireGuard route and QoS enforcement
After=network-online.target wg-quick@wg-pulseroute.service pulseroute-agent.service
Wants=network-online.target
Requires=wg-quick@wg-pulseroute.service pulseroute-agent.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/pulseroute-enforcer watch
ExecStop=/usr/local/sbin/pulseroute-enforcer uninstall
Restart=always
RestartSec=5s
User=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW

[Install]
WantedBy=multi-user.target